# Alan adınız public/ klasörüne yönlendirilemiyorsa (paylaşımlı hosting) bu
# dosya istekleri public/ klasörüne aktarır ve gizli dosyalara erişimi engeller.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(\.env.*|\.git.*|composer\.(json|lock)|artisan|phpunit\.xml)$ - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L,NC]

    RewriteCond %{REQUEST_URI} !(^|/)public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
